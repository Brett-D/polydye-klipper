# PolyDye settings. Copy to ~/printer_data/config/polydye.cfg.
# Loaded only while the PolyDye board is plugged in (see README.md, "The plug-in toggle").

[polydye]
# Required; they depend on the cartridge mount. These are the nominal values (+/-5 mm) for the PolyDye mount with
# the cartridge right of a Sprite extruder, printing along Y. Calibrate them before printing with ink.
pass_axis: y
offset_x: 58.6
offset_y: -8.7
# Moves the ink of reverse passes along the pass axis to line them up with forward passes (mm). The PolyDye page's
# Ink position nudges set this and the offsets live; Store writes them here.
#direction_trim: 0
# Colour registration: where cyan's and yellow's dots go against magenta's, in bus columns along the pass (DIR=1's
# order) and nozzle positions across it. POLYDYE_ALIGN sets them from the alignment page (POLYDYE_ALIGN_PRINT) and
# stores them here. They apply to the passes the add-on draws itself (calibration prints).
#cyan_columns: 0
#cyan_positions: 0
#yellow_columns: 0
#yellow_positions: 0
# Nozzles per inch across the pass; sizes the offset print's X scale (POLYDYE_OFFSET_PRINT). About 300.
#nozzle_dpi: 300
# Leave the cartridge settings unset for the stock PolyDye firmware's: the board starts with them (older board firmware
# started with color_b: update it), and these defaults copy the stock cadence. The bus runs only at the stock clock
# (2.857 MHz); Klipper sets it on every connect.
# Nozzle waveform: color_b_late (stock's, color_b with +1/+2-word retiming), or black_a or black_b for black.
# Default: the board's own (color_b_late).
#cartridge_template: color_b_late
# Fire pulse in bus words (0.35 us each): 6-8, at most 2.9 us. Default: 6 (2.10 us, stock's).
#pulse_words: 6
# Fire gap in us (0-16.8): F5 fires that much later after F3 than stock's timing, so each fire line may fire 4 heaters
# in a packet and two-ink passes aren't split by fire line (README, "Fire gap"; PD_FIRE_GAP_TEST finds the gap).
# Default: the board's own (0, stock's).
#fire_gap_us: 0
# Bus columns per inch along the pass and the pass speed: stock's 3,333 columns per 100 mm (each 423 dpi image column
# twice) at 59.5 mm/s, a column every 504 us.
#dpi: 847
#pass_speed: 59.5
#travel_speed: 150
#extra_run_up: 1.0
# Automatic head warm-up before a live pass when the head hasn't fired (or been warmed by a POLYDYE_PREWARM burst) since
# Klipper started or not for warm_idle_time s (it's too cold to eject again in under 30 s): every nozzle at warm_pulse
# words every warm_period_us for warm_seconds (0 turns it off). POLYDYE_PREWARM's bursts (prewarm_seconds without
# SECONDS) use warm_period_us too, with a 1-word pulse whatever warm_pulse says. After 30 s idle 4 s of warm-up was
# enough to print full lines; both default to 6. 1 word (0.35 us) puts no
# ink down even on a hot head (0.70 us left a dot). No ink may land on the glass bed, so warm_position is sponge (the
# wipe sponge at POLYDYE_WIPE's X, the default), X, Y (a bed spot for the cartridge over printed plastic, e.g. a prime
# pad) or pass (warm_clearance mm behind the pass's run-up start: only with printed plastic there); never over the
# print. Nothing wipes the cartridge there; POLYDYE_WIPE does that on its own.
#warm_seconds: 6
#warm_pulse: 1
#warm_period_us: 254
#warm_idle_time: 5
#prewarm_seconds: 6
#warm_position: sponge
#warm_clearance: 10
# Seconds of stock-pattern spit at the warm spot right after a warm-up (0: none), for testing. Real ink: at the sponge
# or over printed plastic only.
#warm_prespit: 0
# Seconds of POLYDYE_PRIME's stock-pattern spit over the wipe sponge without SECONDS (up to 5): an ink layer whose
# colours haven't ejected for 90 s or more starts with one (0.2 s left a full-width cyan bar's start ragged).
#prime_seconds: 0.3
# Seconds of POLYDYE_CLEAN's stock-pattern spit over the wipe sponge without SECONDS (up to 5), after its warm-up and
# before the wipe strokes.
#clean_seconds: 1.5
# The nozzle row's yaw: position p's dots land nozzle_skew x (p - 50) nozzle pitches further along the pass than
# position 50's, and every pass the add-on draws (calibration prints, ink jobs) moves them back. 0.03 measured on
# Brett's mount; POLYDYE_OFFSET SKEW= SAVE=1 sets it. Print the alignment page again after changing it.
#nozzle_skew: 0

# Where POLYDYE_WIPE meets the sponge (X, G-code coordinates; must be below the X axis maximum). Uncomment to
# change the default of 245:
#[gcode_macro POLYDYE_WIPE]
#variable_x: 245
