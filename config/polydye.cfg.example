# PolyDye settings. Copy to ~/printer_data/config/polydye.cfg.
# Loaded only while the PolyDye board is plugged in (see README.md, "The plug-in toggle").

[polydye]
# Required; they depend on the cartridge mount. These are the nominal front-mount values (+/-5 mm) and are only
# good enough for dry runs until the mount is measured.
pass_axis: y
offset_x: -0.2
offset_y: -77.7
#dpi: 600
#pass_speed: 50
#travel_speed: 150
#extra_run_up: 1.0
